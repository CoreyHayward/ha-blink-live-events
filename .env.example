# Use `latest` for current main, or set a published v* release tag to pin a version.
BLINK_LIVE_EVENTS_IMAGE_TAG=latest

# Paste the private local-only webhook URL from the HA integration Configure screen.
BLINK_LIVE_EVENTS_HA_WEBHOOK_URL=

# Optional Firebase overrides. Leave these unset to use the bundled Blink app values.
# Set only fields that Blink has changed. These are public Firebase client identifiers.
# BLINK_LIVE_EVENTS_FIREBASE_API_KEY=
# BLINK_LIVE_EVENTS_FIREBASE_APP_ID=
# BLINK_LIVE_EVENTS_FIREBASE_PROJECT_ID=
# BLINK_LIVE_EVENTS_FIREBASE_SENDER_ID=
