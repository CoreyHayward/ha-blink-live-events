# Set these to the numeric UID/GID that should own the receiver data volume.
# Export them in your shell before docker compose build/run if they differ from 1000.
BLINK_PUSH_UID=1000
BLINK_PUSH_GID=1000

# Paste the private local-only webhook URL from the HA integration Configure screen.
BLINK_PUSH_HA_WEBHOOK_URL=

# Optional Firebase overrides. Leave these unset to use the bundled Blink app values.
# Set only fields that Blink has changed. These are public Firebase client identifiers.
# BLINK_PUSH_FIREBASE_API_KEY=
# BLINK_PUSH_FIREBASE_APP_ID=
# BLINK_PUSH_FIREBASE_PROJECT_ID=
# BLINK_PUSH_FIREBASE_SENDER_ID=
